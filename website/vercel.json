{
  "headers": [
    {
      "source": "/downloads/(.*).apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"HouseholdExpense.apk\""
        }
      ]
    }
  ],
  "rewrites": [{ "source": "/((?!downloads/|api/|ads\\.txt).*)", "destination": "/index.html" }]
}
